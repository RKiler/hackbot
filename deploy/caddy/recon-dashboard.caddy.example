recon.example.test {
	header {
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Robots-Tag "noindex, nofollow, noarchive"
	}

	# The recon dashboard serves /hackbot and proxies its API to BugHunter over
	# the private Unix socket. BugHunter itself is not exposed directly.
	reverse_proxy 127.0.0.1:5000
}
